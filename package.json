{
  "name": "@8ui/iframe-sdk-core",
  "version": "1.0.3",
  "description": "Universal SDK core for embedding iframe-based services (parent side)",
  "keywords": [
    "sdk",
    "iframe",
    "postmessage",
    "widget",
    "modal"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/8ui/iframe-sdk-core.git"
  },
  "bugs": {
    "url": "https://github.com/8ui/iframe-sdk-core/issues"
  },
  "homepage": "https://github.com/8ui/iframe-sdk-core#readme",
  "main": "dist/iframe-sdk-core.cjs.js",
  "module": "dist/iframe-sdk-core.esm.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist/"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/iframe-sdk-core.esm.js",
      "require": "./dist/iframe-sdk-core.cjs.js"
    }
  },
  "scripts": {
    "build": "NODE_ENV=production rollup -c",
    "build:debug": "DEBUG=true NODE_ENV=development rollup -c",
    "build:dev": "NODE_ENV=development rollup -c",
    "build:watch": "NODE_ENV=development rollup -c -w",
    "type-check": "tsc --noEmit",
    "test": "NODE_OPTIONS='--unhandled-rejections=warn' jest",
    "test:watch": "NODE_OPTIONS='--unhandled-rejections=warn' jest --watch",
    "test:coverage": "NODE_OPTIONS='--unhandled-rejections=warn' jest --coverage"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "rollup": "^4.9.2",
    "rollup-plugin-filesize": "^10.0.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "ts-jest": "^29.1.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3"
  }
}
